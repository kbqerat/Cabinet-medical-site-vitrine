{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "buildCommand": "composer install --no-dev --optimize-autoloader && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
